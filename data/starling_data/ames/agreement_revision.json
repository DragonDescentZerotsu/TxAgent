  "execution": "Fresh catalog; per-split memoization of aggregates only where frozen source, catalog, aggregation code, filter scope, and parent-heldout membership are unchanged. All affected-parent aggregates, complete source filtering, neighbor indices and card validation are rebuilt. Public build_dataset hash/scope checks finalize the manifest.",
  "aggregation_reuse_orchestrator_source": "\"\"\"Memoize unchanged assay aggregates; all filtering/index code stays shared.\"\"\"\nimport collections\nimport functools\nimport json\nfrom pathlib import Path\nimport sys\n\nsys.path.insert(0, str(Path.cwd()))\nimport pyarrow.parquet as pq\nfrom tools.chembl_tool.common import assay_retrieval as ar\nfrom tools.chembl_tool.common.json_utils import sha256_file\nfrom tools.chembl_tool.tasks.ames import build_dataset as build\n\nscheme = sys.argv[1]\nassert scheme in ('scaffold', 'random')\nbefore = json.loads(Path('/local/tmp/ames-agreement60/before.json').read_text())\nroot = build.INDEX_ROOT / scheme\nold_manifest = json.loads((root / 'manifest.json').read_text())\nold_validation = json.loads(build.MANIFEST.with_name('retrieval_validation.json').read_text())\ncode_path = Path(ar.__file__).resolve()\nassert sha256_file(code_path) == old_validation['input_hashes'][str(code_path)]\ncatalog = build.CATALOG_ROOT / 'family_assays.jsonl'\nassert sha256_file(build.RECORDS) == old_manifest['records_sha256']\nassert sha256_file(catalog) == old_manifest['ranked_assays_sha256']\nfor item in before['dataset_manifest']['retrieval']['indices'][scheme]:\n    assert sha256_file(Path(item['path'])) == item['sha256'], item['path']\nassert old_manifest['max_record_examples'] == 3\nassert old_manifest['max_support_text_chars'] == 0\nassert old_manifest['evidence_prompt_profile'] == 'assay_compact.mechanism_tagged_v4'\n\nar._parent_key = functools.lru_cache(maxsize=None)(ar._parent_key)\nold_parents = {\n    ar._parent_key(r['drug']) for split in ('valid', 'test')\n    for r in before['ames_rows'][scheme][split]\n}\nheldout = build.task_root('ames', scheme) / 'heldout_molecule_condition_labels.jsonl'\nnew_parents = {ar._parent_key(r['drug']) for r in ar.read_jsonl(heldout)}\nchanged = old_parents ^ new_parents\nassert len(changed) == 4\nstructures = pq.read_table(build.RECORDS, columns=['molecule_id', 'canonical_smiles']).to_pandas().drop_duplicates()\naffected = set(structures.loc[structures.canonical_smiles.map(ar._parent_key).isin(changed), 'molecule_id'])\ndel structures\nprint('Recomputing all assay groups for changed parents:', len(changed), 'source molecule ids:', len(affected), flush=True)\n\ncache = {}\nevidence = root / 'assay_molecule_evidence.jsonl'\nfor line in evidence.open():\n    row = json.loads(line)\n    if row['molecule_chembl_id'] in affected:\n        continue\n    # These fields are regenerated by the unchanged neighbor-index builder.\n    row.pop('minimal_evidence', None)\n    row.pop('standard_inchi_key', None)\n    key = row['assay_chembl_id'], row['molecule_chembl_id']\n    assert key not in cache\n    cache[key] = row\nprint('Verified cached groups loaded:', len(cache), flush=True)\naggregate = ar._aggregate_assay_molecule\ncounts = collections.Counter()\n\ndef memoized(task, context, assay, group, **kwargs):\n    molecule = str(group['molecule_id'].iloc[0])\n    if molecule in affected:\n        counts['recomputed_changed_parent_groups'] += 1\n        return aggregate(task, context, assay, group, **kwargs)\n    cached = cache.pop((assay, molecule))\n    # The old evidence export held index-standardized SMILES; restore the\n    # source SMILES before normal full-index standardization and fingerprinting.\n    cached['canonical_smiles'] = str(group['canonical_smiles'].iloc[0])\n    assert cached['source_record_count'] == len(group)\n    counts['reused_unchanged_groups'] += 1\n    if counts['reused_unchanged_groups'] % 10000 == 0:\n        fresh = aggregate(task, context, assay, group, **kwargs)\n        fresh.pop('minimal_evidence', None)  # Always rebuilt after standardization.\n        assert cached == fresh, [k for k in set(cached) | set(fresh) if cached.get(k) != fresh.get(k)]\n        counts['independent_aggregate_equality_checks'] += 1\n        print('Verified groups:', counts['reused_unchanged_groups'], flush=True)\n    return cached\n\nar._aggregate_assay_molecule = memoized\nwrite_json = ar.write_json_atomic\n\ndef write_with_receipt(path, value):\n    if Path(path) == root / 'manifest.json':\n        assert not cache, ('unused unaffected cached groups', len(cache))\n        value['aggregation_reuse'] = {\n            'method': 'Unchanged source/catalog/aggregation code plus unchanged parent-heldout membership prove identical group inputs; affected parents are fully recomputed. Complete source filtering and neighbor-index construction are rerun.',\n            'prior_evidence_sha256': old_manifest['evidence_sha256'],\n            'prior_heldout_sha256': old_manifest['heldout_molecules_jsonl_sha256'],\n            'aggregation_code_sha256': sha256_file(code_path),\n            'orchestrator_sha256': sha256_file(Path(__file__)),\n            'changed_parent_keys': sorted(changed),\n            'affected_source_molecule_ids': sorted(affected),\n            'counts': dict(counts),\n            'unused_unaffected_cached_groups': 0,\n        }\n    return write_json(path, value)\n\nar.write_json_atomic = write_with_receipt\nar.main([\n    'build-index', '--task', 'ames', '--records', str(build.RECORDS),\n    '--ranked-assays', str(catalog), '--output-dir', str(root),\n    '--heldout-molecules-jsonl', str(heldout), '--heldout-smiles-field', 'drug',\n    '--filter-scope-field', 'heldout_filter_scope', '--filter-scope-value', 'bacterial_outcome',\n    '--neighbor-identity-policy-default', build.IDENTITY_POLICIES[scheme],\n    '--evidence-prompt-profile', 'assay_compact.mechanism_tagged_v4',\n    '--max-record-examples', '3', '--max-support-text-chars', '0', '--workers', '16',\n])\nprint('PASSED cached aggregation rebuild:', scheme, dict(counts), flush=True)\n",
  "aggregation_comparison": "All aggregate source fields must match; standard_inchi_key and minimal_evidence are regenerated by the unchanged full neighbor-index builder after source-SMILES restoration.",
  "status": "passed",
