{"source_record_id": "sr_3b771129ddd240dba6a7a4afcdfa8ab9", "source_row_uid": "sr_3b771129ddd240dba6a7a4afcdfa8ab9", "source_id": "carcinogens_base", "drug": "Cc1c2ccccc2c(C)c2c1ccc1ccccc12", "molecule_identity_key": "ARSRBNBHOADGJU-UHFFFAOYSA-N", "bemis_murcko_scaffold": "c1ccc2cc3c(ccc4ccccc43)cc2c1", "Y": 1, "condition_atoms": ["species=rat"], "condition_group": "species=rat", "condition_text": "", "pmid": "34869321", "study_id": "pmid:34869321", "label_method": "carcinogens_conditioned_source_votes.v2", "reviewer": "source_contract_with_stratified_codex_audit_not_human_expert", "raw_value": "positive", "molecule_name": "7,12-Dimethylbenz[a]anthracene", "raw_record": {"paragraph_idx": 75, "support_text": "The paper describes that free radicals play an essential role in the pathogenesis of cancer by causing genetic instability, noting that most carcinogens, including DMBA (7,12-Dimethylbenz[a]anthracene), exert their carcinogenic effect by generating free radicals that can damage cellular DNA and lead to the origin of cancer. The same antioxidant-marker changes were observed in DMBA-treated rats in the present study.", "agent_name": "7,12-Dimethylbenz[a]anthracene", "agent_category": "individual_substance_or_drug", "carcinogenicity_conclusion": "positive", "evidence_basis": "animal_carcinogenicity_bioassay", "evidence_scope": "experimental_animal", "evidence_population_or_model": "rat", "cancer_or_tumor": null, "cancer_identifier": null, "carcinogenic_role": "general_or_unspecified_carcinogen", "classification_authority": null, "classification_label": null, "exposure_route": null, "qualifying_conditions": null, "extra_details": "DMBA is used in this study to induce mammary gland carcinoma in rats (treated group compared with rats given VIN and/or VOA, which are anticancer agents). The passage attributes DMBA's carcinogenic effect to the generation of free radicals, introduction of DNA damage, and genetic instability. Aliases: DMBA; CAS-equivalent structure name 7,12-Dimethylbenz[a]anthracene.", "confidence": 0.7, "needs_more_context": false, "pmid": "34869321", "extraction_id": "ext_7", "SMILES": "Cc1c2ccccc2c(C)c2c1ccc1ccccc12", "source_row_uid": "sr_3b771129ddd240dba6a7a4afcdfa8ab9"}, "source_payload_sha256": "e95653407874a6accc7964ffdafd06f5faa447b7ee87e48b91f4fc1985544811", "study_source_row_uids": ["sr_3b771129ddd240dba6a7a4afcdfa8ab9"], "study_source_pmids": ["34869321"], "audit_id": "CF16"}
