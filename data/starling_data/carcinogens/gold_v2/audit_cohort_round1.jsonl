{"source_record_id": "sr_9200a72cbe124790b5158fb10e96d748", "source_row_uid": "sr_9200a72cbe124790b5158fb10e96d748", "source_id": "carcinogens_base", "drug": "ClCCl", "molecule_identity_key": "YMWUJEATGCHHMB-UHFFFAOYSA-N", "bemis_murcko_scaffold": "", "Y": 0, "condition_atoms": ["route=oral", "species=mouse"], "condition_group": "route=oral+species=mouse", "condition_text": "", "pmid": "12559690", "study_id": "pmid:12559690", "label_method": "carcinogens_conditioned_source_votes.v2", "reviewer": "source_contract_with_stratified_codex_audit_not_human_expert", "raw_value": "negative", "molecule_name": "Methylene chloride", "raw_record": {"paragraph_idx": 32, "support_text": "Methylene chloride (CH2Cl2) caused tumors in lung and liver in mice by inhalation at 2000 and 4000 ppm, but was not carcinogenic by the oral route. The PBPK model indicated that ingestion of CH2Cl2 in drinking water, due to slower intake and first-pass liver clearance, would produce very low tissue exposures to the GSH-pathway metabolites.", "agent_name": "Methylene chloride", "agent_category": "individual_substance_or_drug", "carcinogenicity_conclusion": "negative", "evidence_basis": "animal_carcinogenicity_bioassay", "evidence_scope": "experimental_animal", "evidence_population_or_model": "mouse", "cancer_or_tumor": null, "cancer_identifier": null, "carcinogenic_role": null, "classification_authority": null, "classification_label": null, "exposure_route": "oral", "qualifying_conditions": null, "extra_details": "Lack of oral carcinogenicity attributed to low tissue exposures to GSH-pathway metabolites from slower intake and first-pass liver clearance.", "confidence": 0.85, "needs_more_context": false, "pmid": "12559690", "extraction_id": "ext_4", "SMILES": "ClCCl", "source_row_uid": "sr_9200a72cbe124790b5158fb10e96d748"}, "source_payload_sha256": "2dc5d8af18bbc873d90c493979da778b7b1fd5985454e441285edfb8fb17f73b", "study_source_row_uids": ["sr_9200a72cbe124790b5158fb10e96d748"], "study_source_pmid