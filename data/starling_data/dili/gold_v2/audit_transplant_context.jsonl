{"source_record_id": "sr_d56da3d9b412496d837d798ae317deb9", "source_row_uid": "sr_d56da3d9b412496d837d798ae317deb9", "source_id": "dili_base", "drug": "COCc1c(C(C)C)nc(C(C)C)c(/C=C/[C@@H](O)C[C@@H](O)CC(=O)O)c1-c1ccc(F)cc1", "molecule_identity_key": "SEERZIQQUAZTOL-ANMDKAQQSA-N", "bemis_murcko_scaffold": "c1ccc(-c2ccncc2)cc1", "Y": 1, "condition_atoms": ["exposure=therapeutic_use", "population=human", "population_context=liver_transplant"], "condition_group": "exposure=therapeutic_use+population=human+population_context=liver_transplant", "condition_text": "", "pmid": "15789367", "study_id": "pmid:15789367", "label_method": "dili_human_conditioned_source_votes.v2", "reviewer": "source_contract_with_stratified_codex_audit_not_human_expert", "raw_value": "established_or_definite", "molecule_name": "Cerivastatin", "raw_record": {"paragraph_idx": 8, "support_text": "Of 51,741 patients who had liver transplantation performed in the United States between 1990 and 2002, three had liver transplantation for acute liver failure presumably caused by statins; of these, two had acute liver failure caused by cerivastatin, which is no longer available on the market.", "molecule_name": "Cerivastatin", "agent_type": "small_molecule_or_chemical", "liver_injury_identifier": "UMLS:C0162557", "causal_status": "established_or_definite", "human_evidence_basis": "registry_or_adjudicated_cohort", "exposure_context": "therapeutic_use", "reaction_type": null, "biochemical_pattern": null, "clinical_phenotype": "nonspecific_liver_injury", "maximum_reported_severity": "liver_transplantation", "qualifying_conditions": null, "extra_details": "Two of three US liver transplant patients (1990-2002, among 51,741 transplants) underwent liver transplantation for acute liver failure caused by cerivastatin; cerivastatin is no longer available on the market.", "confidence": 0.8, "needs_more_context": false, "pmid": "15789367", "extraction_id": "ext_1", "SMILES": "COCc1c(C(C)C)nc(C(C)C)c(/C=C/[C@@H](O)C[C@@H](O)CC(=O)O)c1-c1ccc(F)cc1", "source_row_uid": "sr_d56da3d9b412496d837d798ae317deb9"}, "source_payload_sha256": "e8f5273a4e33ef6c6c597f71ea97d828358384bb020f65773b0d5c295e45fa20", "study_source_row_uids": ["sr_d56da3d9b412496d837d798ae317deb9"], "study_source_pmids": ["15789367"], "identity_verification": "pubchem_name_exact_parent_match", "source_parent_smiles": "COCc1c(C(C)C)nc(C(C)C)c(/C=C/[C@@H](O)C[C@@H](O)CC(=O)O)c1-c1ccc(F)cc1", "audit_id": "DT3"}
{"source_record_id": "sr_c97675c15b38487ab8bf90fde67b4476", "source_row_uid": "sr_c97675c15b38487ab8bf90fde67b4476", "source_id": "dili_base", "drug": "CC(=O)Nc1ccc(O)cc1", "molecule_identity_key": "RZVAJINKPMORJF-UHFFFAOYSA-N", "bemis_murcko_scaffold": "c1ccccc1", "Y": 1, "condition_atoms": ["exposure=therapeutic_use", "population=human", "population_context=liver_transplant"], "condition_group": "exposure=therapeutic_use+population=human+population_context=liver_transplant", "condition_text": "", "pmid": "20374223", "study_id": "cited:usa:1990", "label_method": "dili_human_conditioned_source_votes.v2", "reviewer": "source_contract_with_stratified_codex_audit_not_human_expert", "raw_value": "established_or_definite", "molecule_name": "Paracetamol", "raw_record": {"paragraph_idx": 28, "support_text": "Among patients with acute liver failure resulting from drugs in the US who underwent liver transplantation, paracetamol (acetaminophen) was the most common causative drug.", "molecule_name": "Paracetamol", "agent_type": "small_molecule_or_chemical", "liver_injury_identifier": "UMLS:C0860207", "causal_status": "established_or_definite", "human_evidence_basis": "registry_or_adjudicated_cohort", "exposure_context": "therapeutic_use", "reaction_type": null, "biochemical_pattern": null, "clinical_phenotype": null, "maximum_reported_severity": "acute_liver_failure", "qualifying_conditions": null, "extra_details": "Most common causative drug among US patients with drug-induced acute liver failure who underwent liver transplantation; followed in frequency by isoniazid, propylthiouracil, phenytoin and valproate. Also listed in the USA 1990-2002 series (Russo et al.) as 46% of 270 acute liver failure cases.", "confidence": 0.9, "needs_more_context": false, "pmid": "20374223", "extraction_id": "ext_40", "SMILES": "CC(=O)Nc1ccc(O)cc1", "source_row_uid": "sr_c97675c15b38487ab8bf90fde67b4476"}, "source_payload_sha256": "038fce7022ebcba7786c88d1b6b3f971aaf06e3369b358c1edae5384113477e3", "study_source_row_uids": ["sr_c97675c15b38487ab8bf90fde67b4476"], "study_source_pmids": ["20374223"], "identity_verification": "pubchem_name_exact_parent_match", "source_parent_smiles": "CC(=O)Nc1ccc(O)cc1", "audit_id": "DT4"}
{"source_record_id": "sr_6c516d7f247741ceb1c375cd9bc294d2", "source_row_uid": "sr_6c516d7f247741ceb1c375cd9bc294d2", "source_id": "dili_base", "drug": "C[C@@H]1O[C@@H]1P(=O)(O)O", "molecule_identity_key": "YMDXZJFXQJVXBF-STHAYSLISA-N", "bemis_murcko_scaffold": "C1CO1", "Y": 1, "condition_atoms": ["exposure=therapeutic_use", "population=human", "population_context=liver_transplant"], "condition_group": "exposure=therapeutic_use+population=human+population_context=liver_transplant", "condition_text": "", "pmid": "38571841", "study_id": "pmid:38571841", "label_method": "dili_human_conditioned_source_votes.v2", "reviewer": "source_contract_with_stratified_codex_audit_not_human_expert", "raw_value": "probable", "molecule_name": "Fosfomycin", "raw_record": {"paragraph_idx": 24, "support_text": "The reported case had an R factor of 12, a hepatocellular pattern of liver injury, and a RUCAM score of 8, indicating a 'probable' association of the DILI with fosfomycin. A rechallenge was not performed for ethical reasons.", "molecule_name": "Fosfomycin", "agent_type": "small_molecule_or_chemical", "liver_injury_identifier": "UMLS:C0860207", "causal_status": "probable", "human_evidence_basis": "individual_case", "exposure_context": "therapeutic_use", "reaction_type": null, "biochemical_pattern": "hepatocellular", "clinical_phenotype": "acute_hepatitis", "maximum_reported_severity": "acute_liver_failure", "qualifying_conditions": null, "extra_details": "Presented case: acute liver injury with aminotransferases >1000 IU/L, R factor 12, RUCAM score 8 ('probable'). Fosfomycin is described as a rare cause of liver injury, presenting with mild aminotransferase elevations in 1%-2% of patients. Literature: Matsumori et al. reported a 30-year-old male with mixed-pattern injury three days after oral fosfomycin who developed features of liver failure (encephalopathy and coagulopathy) without need for liver transplantation, enzyme normalization four months after onset; Durupt et al. reported a 30-year-old female with cystic fibrosis who developed liver injury four days after parenteral fosfomycin with resolution one month after discontinuation and positive rechallenge twice (enzymes increased three days after administration, normalized within a week); Wang et al. reported a 50-year-old male with mixed liver injury three days after fosfomycin exposure resolving within a week; Ferreira et al. reported a 24-year-old female with hepatocellular injury one week after a single 3 g oral dose resolving three months after exposure. First-line management was discontinuation of the agent.", "confidence": 0.9, "needs_more_context": false, "pmid": "38571841", "extraction_id": "ext_4", "SMILES": "C[C@@H]1O[C@@H]1P(=O)(O)O", "source_row_uid": "sr_6c516d7f247741ceb1c375cd9bc294d2"}, "source_payload_sha256": "11702e7e695c5026dcc108d70e5266efb0d883d49d737d88d285bb0209025434", "study_source_row_uids": ["sr_6c516d7f247741ceb1c375cd9bc294d2"], "study_source_pmids": ["38571841"], "identity_verification": "pubchem_name_exact_parent_match", "source_parent_smiles": "C[C@@H]1O[C@@H]1P(=O)(O)O", "audit_id": "DT5"}
{"source_record_id": "sr_fc821a10f57e44f188869a5c31161f09", "source_row_uid": "sr_fc821a10f57e44f188869a5c31161f09", "source_id": "dili_base", "drug": "NNC(=O)c1ccncc1", "molecule_identity_key": "QRXWMOHMRWLFEY-UHFFFAOYSA-N", "bemis_murcko_scaffold": "c1ccncc1", "Y": 1, "condition_atoms": ["exposure=therapeutic_use", "population=human", "population_context=liver_transplant"], "condition_group": "exposure=therapeutic_use+population=human+population_context=liver_transplant", "condition_text": "", "pmid": "17539980", "study_id": "pmid:17539980", "label_method": "dili_human_conditioned_source_votes.v2", "reviewer": "source_contract_with_stratified_codex_audit_not_human_expert", "raw_value": "established_or_definite", "molecule_name": "Isoniazid", "raw_record": {"paragraph_idx": 21, "support_text": "Isoniazid-associated DILI case reports were analyzed for liver-injury pattern, eosinophilia, hepatic necrosis, inflammatory reaction, and death/liver transplantation outcomes.", "molecule_name": "Isoniazid", "agent_type": "small_molecule_or_chemical", "liver_injury_identifier": "UMLS:C0860207", "causal_status": "established_or_definite", "human_evidence_basis": "case_series", "exposure_context": "therapeutic_use", "reaction_type": null, "biochemical_pattern": "multiple_or_variable", "clinical_phenotype": "nonspecific_liver_injury", "maximum_reported_severity": "death", "qualifying_conditions": null, "extra_details": "46 individual case reports; median age 39 y; 25 female/21 male; median treatment duration 5 weeks; HC 93%, Cs/mixed 7%; peripheral eosinophilia present in 18% (44/46 reported); hepatic eosinophilia present in 24% (34/46 reported); hepatic necrosis 65%; inflammatory reaction 68%; death or liver transplant 35%; liver biopsy reported in 33/46 cases.", "confidence": 0.9, "needs_more_context": false, "pmid": "17539980", "extraction_id": "ext_30", "SMILES": "NNC(=O)c1ccncc1", "source_row_uid": "sr_fc821a10f57e44f188869a5c31161f09"}, "source_payload_sha256": "6a12133ad