{"source_record_id": "sr_2fb5df456edf49bd9c959d0fd593999c", "source_row_uid": "sr_2fb5df456edf49bd9c959d0fd593999c", "source_id": "dili_base", "drug": "CC(=O)Nc1ccc(O)cc1", "molecule_identity_key": "RZVAJINKPMORJF-UHFFFAOYSA-N", "bemis_murcko_scaffold": "c1ccccc1", "Y": 1, "condition_atoms": ["exposure=therapeutic_use", "population=human", "population_context=liver_transplant"], "condition_group": "exposure=therapeutic_use+population=human+population_context=liver_transplant", "condition_text": "", "pmid": "19847399", "study_id": "cited:november:2006", "label_method": "dili_human_conditioned_source_votes.v2", "reviewer": "source_contract_with_stratified_codex_audit_not_human_expert", "raw_value": "established_or_definite", "molecule_name": "Paracetamol", "raw_record": {"paragraph_idx": 2948, "support_text": "In this prospective audit of interhospital telephone referrals to a 15-bed liver intensive therapy unit (March–November 2006), drug-induced acute liver dysfunction/failure (ALDF) was the most common reason for consultation (39%), with paracetamol being the most common agent (163/172 drug-induced ALDF referrals).", "molecule_name": "Paracetamol", "agent_type": "small_molecule_or_chemical", "liver_injury_identifier": "UMLS:C0085605", "causal_status": "established_or_definite", "human_evidence_basis": "case_series", "exposure_context": "therapeutic_use", "reaction_type": null, "biochemical_pattern": null, "clinical_phenotype": "other_specific_phenotype", "maximum_reported_severity": "acute_liver_failure", "qualifying_conditions": null, "extra_details": "Paracetamol accounted for 163/172 (95%) of drug-induced acute liver dysfunction/failure (ALDF) consultations in this referral cohort; most such patients (63%) were triaged to a referral-hospital ward rather than to LITU (14%). Acute liver failure is the attributed phenotype (drug-induced ALDF). Among LITU-admitted patients with ALDF, 10/49 underwent liver transplantation and mortality in the ALDF subgroup was 25%.", "confidence": 0.8, "needs_more_context": false, "pmid": "19847399", "extraction_id": "ext_2", "SMILES": "CC(=O)Nc1ccc(O)cc1", "source_row_uid": "sr_2fb5df456edf49bd9c959d0fd593999c"}, "source_payload_sha256": "a5c9fe226b080b1a3723f0cbbb6ba7604294f9bb339f5bc0bf58d0bcb8ca8e0c", "study_source_row_uids": ["sr_2fb5df456edf49bd9c959d0fd593999c"], "study_source_pmids": ["19847399"], "identity_verification": "pubchem_name_exact_parent_match", "source_parent_smiles": "CC(=O)Nc1ccc(O)cc1", "audit_id": "DT1"}
{"source_record_id": "sr_4f6a2a74e28a4623bc03b5693ab48897", "source_row_uid": "sr_4f6a2a74e28a4623bc03b5693ab48897", "source_id": "dili_base", "drug": "CN1C(C(=O)Nc2ccccn2)=C(O)c2ccccc2S1(=O)=O", "molecule_identity_key": "QYSPLQLAKJAUJT-UHFFFAOYSA-N", "bemis_murcko_scaffold": "O=C(Nc1ccccn1)C1=Cc2ccccc2S(=O)(=O)N1", "Y": 1, "condition_atoms": ["exposure=therapeutic_use", "population=human", "population_context=liver_transplant"], "condition_group": "exposure=therapeutic_use+population=human+population_context=liver_transplant", "condition_text": "", "pmid": "18049158", "study_id": "pmid:18049158", "label_method": "dili_human_conditioned_source_votes.v2", "reviewer": "source_contract_with_stratified_codex_audit_not_human_expert", "raw_value": "established_or_definite", "molecule_name": "Piroxicam", "raw_record": {"paragraph_idx": 6, "support_text": "Among the five consecutively diagnosed cases of NSAID-induced fulminant hepatitis, one case was related to piroxicam at a dose of 20 mg/day, and the patient was successfully treated by orthotopic liver transplantation. Diagnosis was based on exclusion of other potentially hepatotoxic medications and causes of liver failure.", "molecule_name": "Piroxicam", "agent_type": "small_molecule_or_chemical", "liver_injury_identifier": "UMLS:C0860207", "causal_status": "established_or_definite", "human_evidence_basis": "case_series", "exposure_context": "therapeutic_use", "reaction_type": null, "biochemical_pattern": null, "clinical_phenotype": "acute_hepatitis", "maximum_reported_severity": "liver_transplantation", "qualifying_conditions": null, "extra_details": "1 of 5 cases of NSAID-induced acute liver failure; dose 20 mg/day; treated by orthotopic liver transplantation for fulminant hepatitis.", "confidence": 0.9, "needs_more_context": false, "pmid": "18049158", "extraction_id": "ext_4", "SMILES": "CN1C(C(=O)Nc2ccccn2)=C(O)c2ccccc2S1(=O)=O", "source_row_uid": "sr_4f6a2a74e28a4623bc03b5693ab48897"}, "source_payload_sha256": "ae00