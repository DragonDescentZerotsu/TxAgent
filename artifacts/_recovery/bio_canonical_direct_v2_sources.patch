+def _clean_canonical_direct_claims(
+    rows: list[dict[str, Any]],
+    *,
+    min_value_percent: float,
+    max_value_percent: float,
+) -> tuple[list[CleanOralBioavailabilityRow], list[dict[str, Any]]]:
+    """Use canonical-v2 parsing decisions instead of reinterpreting claim text."""
+    cleaned: list[CleanOralBioavailabilityRow] = []
+    dropped: list[dict[str, Any]] = []
+    for source_index, raw in enumerate(rows):
+        report_type = str(raw.get("bioavailability_report_type") or "").strip()
+        if report_type not in DIRECT_REPORT_TYPES:
+            dropped.append(
+                {"source_index": source_index, "drop_reason": "report_type_not_allowed", "raw_row": raw}
+            )
+            continue
+        canonical_smiles = canonicalize_smiles(str(raw.get("smiles") or "").strip())
+        if not canonical_smiles:
+            dropped.append(
+                {"source_index": source_index, "drop_reason": "invalid_smiles", "raw_row": raw}
+            )
+            continue
+        value = _finite_float(raw.get("value_percent"))
+        if value is None:
+            dropped.append(
+                {
+                    "source_index": source_index,
+                    "drop_reason": "unparseable_or_non_numeric_value",
+                    "raw_row": raw,
+                }
+            )
+            continue
+        if value < min_value_percent or value > max_value_percent:
+            dropped.append(
+                {"source_index": source_index, "drop_reason": "value_out_of_range", "raw_row": raw}
+            )
+            continue
+        parse_method = str(raw.get("value_parse_method") or "canonical_value_percent")
+        parse_modifier = parse_method if parse_method in {"lower_bound", "upper_bound"} else ""
+        cleaned.append(
+            CleanOralBioavailabilityRow(
+                source_index=source_index,
+                molecule_name=str(raw.get("molecule_name") or "").strip(),
+                canonical_smiles=canonical_smiles,
+                value_percent=value,
+                condition_text=build_condition_text(raw),
+                parse_method=parse_method,
+                parse_modifier=parse_modifier,
+                raw_row=raw,
+            )
+        )
+    return cleaned, dropped
+
+
+def _finite_float(value: Any) -> float | None:
+    try:
+        parsed = float(value)
+    except (TypeError, ValueError):
+        return None
+    return parsed if math.isfinite(parsed) else None
+
