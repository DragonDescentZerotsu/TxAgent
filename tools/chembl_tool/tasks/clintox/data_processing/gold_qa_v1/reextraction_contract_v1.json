{
  "contract_version": "clintox_human_claim_reextraction.v1",
  "extends": {
    "path": "data/starling_data/clintox/send_v2/human_clinical_toxicity/extraction_guidance.json",
    "sha256": "94b520acf0c58979580ba685e32a48d5c9f2853f7640e452e6c75adacd8dcb88"
  },
  "purpose": "Add the structured semantics required to decide whether a human clinical claim can vote in a molecule-level toxicity benchmark. Preserve every existing source field.",
  "required_fields": [
    {
      "name": "structure_entity_relation",
      "allowed_values": [
        "exact_molecule_or_active_moiety",
        "salt_or_solvate_same_active_moiety",
        "formulation_or_conjugate",
        "mixture_or_combination",
        "metabolite_or_payload",
        "class_level",
        "unclear"
      ]
    },
    {
      "name": "human_evidence_scope",
      "allowed_values": [
        "direct_human_exposure",
        "pharmacovigilance_or_clinical_label",
        "not_human_clinical_evidence",
        "unclear"
      ]
    },
    {
      "name": "causal_attribution",
      "allowed_values": [
        "molecule_attributed",
        "combination_attributed",
        "comparator_or_background",
        "protective_or_preventive",
        "unclear"
      ]
    },
    {
      "name": "toxicity_direction",
      "allowed_values": [
        "toxicity_observed",
        "toxicity_absent",
        "reduced_risk_or_null_comparison",
        "not_a_toxicity_outcome",
        "unclear"
      ]
    },
    {
      "name": "clinical_significance",
      "allowed_values": [
        "fatal",
        "serious_or_life_threatening",
        "dose_limiting",
        "treatment_limiting",
        "clinically_significant_organ_injury",
        "mild_or_non_serious",
        "no_toxicity_reported",
        "unclear"
      ]
    },
    {
      "name": "absence_scope",
      "allowed_values": [
        "broad_safety_assessment",
        "single_endpoint",
        "severity_limited",
        "not_applicable",
        "unclear"
      ]
    },
    {
      "name": "qualifying_conditions",
      "value_type": "string_or_null",
      "description": "Material co-treatment, formulation, route, population, schedule, or other condition required for the claim. Routine study context remains in clinical_context."
    }
  ],
  "shared_gold_requirements": {
    "structure_entity_relation": [
      "exact_molecule_or_active_moiety",
      "salt_or_solvate_same_active_moiety"
    ],
    "human_evidence_scope": [
      "direct_human_exposure",
      "pharmacovigilance_or_clinical_label"
    ],
    "causal_attribution": [
      "molecule_attributed"
    ],
    "qualifying_conditions": null,
    "unclear_values": "reject_from_gold_and_retain_as_residual_evidence"
  },
  "candidate_label_profiles": {
    "clinically_meaningful_v1_recommended": {
      "positive": {
        "toxicity_direction": "toxicity_observed",
        "clinical_significance": [
          "fatal",
          "serious_or_life_threatening",
          "dose_limiting",
          "treatment_limiting",
          "clinically_significant_organ_injury"
        ]
      },
      "negative": {
        "toxicity_direction": "toxicity_absent",
        "clinical_significance": "no_toxicity_reported",
        "absence_scope": "broad_safety_assessment"
      }
    },
    "any_attributed_adverse_event_v1": {
      "positive": {
        "toxicity_direction": "toxicity_observed",
        "clinical_significance": "any_value_except_no_toxicity_reported_or_unclear"
      },
      "negative": {
        "toxicity_direction": "toxicity_absent",
        "clinical_significance": "no_toxicity_reported",
        "absence_scope": "broad_safety_assessment"
      }
    }
  },
  "non_gold_rows": "Retain unchanged in the human clinical residual evidence partition with the structured exclusion reason."
}
