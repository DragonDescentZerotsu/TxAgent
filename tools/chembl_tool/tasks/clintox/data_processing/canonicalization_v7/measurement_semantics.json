  "review_basis": "Full seven-source endpoint, metric and unit census; exact source schema definitions; representative support-text review; fail-closed long tail.",
  "unit_aliases": [
    {
      "rule_id": "clintox.nonclinical.body_weight_daily_mg_alias.v1",
      "source_ids": ["nonclinical_in_vivo_toxicity"],
      "raw_units": [
        "mg/kg b.w. per day",
        "mg/kg b.w./d",
        "mg/kg b.w./day",
        "mg/kg body weight per day",
        "mg/kg body weight/day",
        "mg/kg bw per day",
        "mg/kg bw/d",
        "mg/kg bw/day",
        "mg/kg bw/day (nominal)",
        "mg/kg bw/day nominal",
        "mg/kg-d",
        "mg/kg-day"
      ],
      "replacement_unit": "mg/kg/d",
      "review": "Exact toxicology dose-basis spellings; bw and b.w. mean body weight and per day is retained."
    },
    {
      "rule_id": "clintox.nonclinical.body_weight_mg_alias.v1",
      "source_ids": ["nonclinical_in_vivo_toxicity"],
      "raw_units": [
        "mg/kg b.w.",
        "mg/kg body wt",
        "mg/kg body weight",
        "mg/kg of body weight",
        "mg/kg bw"
      ],
      "replacement_unit": "mg/kg",
      "review": "Exact mass-per-body-weight spellings; no time basis is added."
    },
    {
      "rule_id": "clintox.nonclinical.mortality_duration_percent_alias.v1",
      "source_ids": [
        "nonclinical_in_vivo_toxicity"
      ],
      "raw_units": [
        "% (50 h)",
        "% (72 h)"
      ],
      "replacement_unit": "%",
      "review": "The parenthesized hour is an observation-time annotation, not a multiplicative unit factor."
    },
    {
      "rule_id": "clintox.cytotoxicity.cell_population_percent_alias.v1",
      "source_ids": [
        "general_cytotoxicity"
      ],
      "raw_units": [
        "% of cells"
      ],
      "replacement_unit": "%",
      "review": "The assessed cell population is the percentage denominator, not a count multiplier."
    },
    {
      "rule_id": "clintox.offtarget.administered_dose_percent_alias.v1",
      "source_ids": [
        "off_target_ddi_exposure"
      ],
      "raw_units": [
        "% administered dose",
        "% dose",
        "% of administered dose",
        "% of dose",
        "percent of administered dose",
        "percent of dose"
      ],
      "replacement_unit": "%",
      "review": "These reviewed generic spellings all use the administered dose as denominator; compound-specific dose strings remain unresolved."
    },
    {
      "rule_id": "clintox.nonclinical.body_weight_g_alias.v1",
      "source_ids": ["nonclinical_in_vivo_toxicity"],
      "raw_units": ["g/kg b.w.", "g/kg body weight", "g/kg bw"],
      "replacement_unit": "g/kg",
      "review": "Exact gram-per-body-weight spellings; mass prefix is preserved before conversion."
    },
    {
      "rule_id": "clintox.nonclinical.body_weight_ug_alias.v1",
      "source_ids": ["nonclinical_in_vivo_toxicity"],
      "raw_units": ["µg/kg body weight", "µg/kg bw"],
      "replacement_unit": "µg/kg",
      "review": "Exact microgram-per-body-weight spellings; mass prefix is preserved before conversion."
    }
  ],
  "rules": [
    {
      "rule_id": "clintox.nonclinical.benchmark_dose_rate.v1",
      "priority": 900,
      "selector": {
        "source_ids": ["nonclinical_in_vivo_toxicity"],
        "field_regex": {"canonical_endpoint": "(?:ld|lc|td|ec)\\d+|mtd|noael|loael|noel|loel|noec|loec|noaec|loaec|dose_limiting_toxicity"},
        "unit_kinds": ["mass_dose_rate"]
      },
      "action": {
        "status": "approved",
        "quantity_kind": "toxicology_benchmark_dose_rate",
        "numeric_domain": "positive",
        "semantic_unit_basis": "mass_per_body_weight_per_time",
        "target_unit": "mg/kg/d",
        "reference_scope": "absolute",
        "reference_basis": "none"
      },
      "review": "Named in-vivo toxicology benchmark with an explicit body-weight and time basis."
    },
    {
      "rule_id": "clintox.nonclinical.benchmark_dose.v1",
