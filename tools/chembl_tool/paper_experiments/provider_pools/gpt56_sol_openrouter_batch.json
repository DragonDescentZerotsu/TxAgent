{
  "version": "openai_provider_pool.v1",
  "providers": [
    {
      "name": "openrouter_sol_batch",
      "base_url": "https://openrouter.ai/api/v1",
      "model": "openai/gpt-5.6-sol",
      "api_key_env": "OPENROUTER_API_KEY",
      "max_inflight": 128,
      "timeout_s": 60,
      "initial_latency_s": 180,
      "transport": "openrouter_batch",
      "temperature": null,
      "reasoning_effort": "medium",
      "batch_options": {
        "max_requests": 128,
        "max_bytes": 16777216,
        "flush_seconds": 2,
        "poll_seconds": 15
      }
    }
  ],
  "max_failovers": 0
}
