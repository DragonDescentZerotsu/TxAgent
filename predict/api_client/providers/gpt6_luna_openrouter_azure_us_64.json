{
  "version": "openai_provider_pool.v1",
  "providers": [
    {
      "name": "azure_us",
      "base_url": "https://openrouter.ai/api/v1",
      "model": "openai/gpt-6-luna",
      "api_key_env": "OPEN_ROUTER_KEY",
      "max_inflight": 64,
      "initial_latency_s": 120,
      "timeout_s": 3600,
      "request_extra_body": {
        "provider": {
          "only": ["azure/us"],
          "allow_fallbacks": false,
          "require_parameters": true
        },
        "reasoning": {"enabled": true},
        "allowed_served_models": ["openai/gpt-6-luna"],
        "expected_upstream_provider": "Azure"
      }
    }
  ],
  "failure_threshold": 64,
  "cooldown_seconds": 5,
  "max_failovers": 0
}
