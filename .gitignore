/data/starling_data/dili/progressive_v1/indices/*/assay_molecule_evidence.jsonl
/data/starling_data/carcinogens/progressive_v1/indices/*/assay_neighbor_index.pkl
/data/starling_data/carcinogens/progressive_v1/indices/*/assay_molecule_evidence.jsonl

