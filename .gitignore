.env
# Local agent instructions are not part of the anonymous review release.
AGENTS.md
.DS_Store
__pycache__/
*.py[cod]
outputs/
build/
dist/
*.egg-info/

# Conditioned-benchmark builders stage reproducible publication inputs here.
# Current, reviewable outputs live under data/conditioned_benchmark/ instead.
data/.build/

# Starling acquisition queues are reproducible local intermediates and may
# exceed GitHub's per-file size limit. Keep the extracted evidence and compact
# provenance files, but not the PMID work queue.
data/starling_data/**/pmids_to_process.json
temp.md
temp.tsv

# Large Ames canonical table is restored from current_records archive parts.
/data/starling_data/ames/canonical_v1/records.parquet

# DILI/Carcinogens full tables restore from shared current_records parts;
# raw acquisition parts and compact audit/gold ledgers remain ordinary files.
/data/starling_data/dili/canonical_v1/records.parquet
/data/starling_data/carcinogens/canonical_v1/records.parquet
/data/starling_data/dili/progressive_v1/records.parquet
/data/starling_data/carcinogens/progressive_v1/records.parquet
