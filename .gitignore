.env
.DS_Store
__pycache__/
*.py[cod]
outputs/
.scratch/

# Track only the compatibility links created by the canonical data layout.
!outputs/
outputs/*
!outputs/chembl_tool/
outputs/chembl_tool/*
!outputs/chembl_tool/tasks/
!outputs/chembl_tool/smiles_identity_audit_v2
outputs/chembl_tool/tasks/*
!outputs/chembl_tool/tasks/bbb_martins/
!outputs/chembl_tool/tasks/bioavailability_ma/
!outputs/chembl_tool/tasks/skin_reaction/
!outputs/chembl_tool/tasks/clintox
outputs/chembl_tool/tasks/bbb_martins/*
outputs/chembl_tool/tasks/bioavailability_ma/*
outputs/chembl_tool/tasks/skin_reaction/*
!outputs/chembl_tool/tasks/bbb_martins/analysis
!outputs/chembl_tool/tasks/bbb_martins/evidence_library/
!outputs/chembl_tool/tasks/bioavailability_ma/evidence_library/
!outputs/chembl_tool/tasks/skin_reaction/evidence_library/
!outputs/chembl_tool/tasks/bbb_martins/evidence_library/*
!outputs/chembl_tool/tasks/bioavailability_ma/evidence_library/*
!outputs/chembl_tool/tasks/skin_reaction/evidence_library/*

# The canonical Joseph final collection is shipped as a verified Git bundle.
!outputs/paper/
outputs/paper/*
!outputs/paper/assay_transfer_harness/
outputs/paper/assay_transfer_harness/*
!outputs/paper/assay_transfer_harness/joseph/
outputs/paper/assay_transfer_harness/joseph/*
!outputs/paper/assay_transfer_harness/joseph/final/
outputs/paper/assay_transfer_harness/joseph/final/*
!outputs/paper/assay_transfer_harness/joseph/final/collection.json
!outputs/paper/assay_transfer_harness/joseph/final/git_bundle/

# Live evidence-library payloads are local restores/builds. Track CURRENT
# pointers and portable release parts under data/artifacts instead.
data/evidence_libraries/*/v*/
data/legacy/evidence_libraries/
data/legacy/clintox/evidence_libraries/
data/legacy/clintox/outputs/
data/artifacts/build_failures/ames/v7/partial_payload_to_delete/

# ClinTox send_v2 is tracked as its exact supplied archive split into verified
# sub-100 MB parts. These byte-identical extracted Parquets are local restores.
data/starling_data/clintox/send_v2/*/extractions.parquet
data/legacy/clintox/raw/starling_data/send_v2/*/extractions.parquet

# Starling acquisition queues are reproducible local intermediates and may
# exceed GitHub's per-file size limit. Keep the extracted evidence and compact
# provenance files, but not the PMID work queue.
data/starling_data/**/pmids_to_process.json
temp.md
temp.tsv
keys.py
.runtime/
.claude/*.lock
predict/traces/runs/*
!predict/traces/runs/README.md
# Published Gold-v1 direct caches are small enough for normal Git. Keep every
# other generated retrieval cache ignored.
predict/retrieval/cache/*
!predict/retrieval/cache/assay_reranking/
predict/retrieval/cache/assay_reranking/*
!predict/retrieval/cache/assay_reranking/active/
predict/retrieval/cache/assay_reranking/active/*
!predict/retrieval/cache/assay_reranking/active/v10_3_best_scaffold_morgan100_v1/
!predict/retrieval/cache/assay_reranking/active/v10_3_best_scaffold_morgan100_v1/**
!predict/retrieval/cache/assay_reranking/active/v9_skin_gold_v1_scaffold_morgan100_v1/
!predict/retrieval/cache/assay_reranking/active/v9_skin_gold_v1_scaffold_morgan100_v1/**

# Bulk scientific payloads are durable on /vast, not in Git. Existing files
# already tracked upstream remain tracked; do not add new payloads here.
/.tmp/
/data/artifacts/
/data/legacy/
/data/caches/
/semantic_buckets/history/
/semantic_buckets/releases/
/semantic_buckets/provenance/

# Local source/review artifacts above the repository's 100 MB file limit.
/ames.tar.gz
/carcinogen_dili.tar.gz
/data/artifacts/_shared/smiles/smiles_identity_audit_v2/name_extraction/full/row_extractions.parquet
/data/artifacts/evidence_library_assets/skin_reaction/construction_assets/auxiliary_reconciliation_v2/provenance/provisional_cluster_mapping.json

# Durable scientific payloads above GitHub's 100 MB per-file limit. Keep these
# on /vast and commit their compact manifests, hashes, and validation receipts.
/semantic_buckets/**/requests.sqlite3
/data/raw/starling/main_universe_v1/*/records.parquet
/data/caches/**/rankings.sqlite3
/data/caches/**/records.parquet
/data/legacy/artifacts/evidence_libraries/**/records.parquet
/data/artifacts/gold_labels/conditioned_benchmark/v2_stage1/**/records.parquet

# Generated unit maps above GitHub's 100 MB per-file limit.
/data/processing/evidence_library/versions/v10/tasks/carcinogens/data_processing/canonicalization_v10/unit_reconciliation_v3/mapping.json
/data/processing/evidence_library/versions/v10/tasks/carcinogens/data_processing/canonicalization_v10/unit_reconciliation_v5/mapping.json
/data/processing/evidence_library/versions/v10/tasks/carcinogens/data_processing/canonicalization_v10/unit_reconciliation_v6/mapping.json
